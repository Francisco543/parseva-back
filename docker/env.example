# Fragmento para pegar en invoicely-back/.env (junto al DATABASE_URL del backend).
# Si PostgreSQL nativo de Windows ya usa el puerto 5432, cambia POSTGRES_PUBLISH_PORT y DATABASE_URL.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=invoicely_dev_change_me
POSTGRES_DB=invoicely
POSTGRES_PUBLISH_PORT=5432

# Debe coincidir con las variables de arriba (usuario, password, puerto, nombre de base):
# DATABASE_URL="postgresql://postgres:invoicely_dev_change_me@localhost:5432/invoicely?schema=public"
