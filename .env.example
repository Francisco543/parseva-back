DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoicely?schema=public"

PORT=4000
NODE_ENV=development

MSAL_TENANT_ID=common
MSAL_CLIENT_ID=your-api-client-id
MSAL_CLIENT_SECRET=your-api-client-secret
MSAL_REDIRECT_URI=http://localhost:4000/api/auth/callback
MSAL_POST_LOGIN_REDIRECT_URI=http://localhost:3000
MSAL_AUTH_SCOPES=openid profile email offline_access
MSAL_ALLOWED_TENANT_IDS=
MSAL_ALLOWED_AUDIENCES=your-api-client-id,api://your-api-client-id
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=invoicely_session
AUTH_FLOW_COOKIE_NAME=invoicely_auth_flow
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=invoicely-backend
KAFKA_GROUP_ID=invoicely-email-workers
KAFKA_EMAIL_TOPIC=email-processing-jobs
KAFKA_EMAIL_RETRY_TOPIC=email-processing-jobs.retry
KAFKA_EMAIL_DLQ_TOPIC=email-processing-jobs.dlq
# Máximo de intentos antes de mandar a DLQ (incluye el primer intento)
KAFKA_EMAIL_MAX_ATTEMPTS=5
# Sync Business Central (un mensaje por BcSyncEvent; consumer group aparte del de email)
KAFKA_BC_SYNC_TOPIC=parseva-bc-sync
KAFKA_BC_SYNC_GROUP_ID=parseva-bc-sync-workers
KAFKA_BC_SYNC_DLQ_TOPIC=parseva-bc-sync.dlq
PUBLIC_API_BASE_URL=http://localhost:4000/api

# Business Central — credenciales globales de la app Parseva en Entra (multi-inquilino).
# El workspace solo guarda tenant/entorno/empresa; el admin del cliente debe consentir la app.
# Consentimiento admin (reemplazar CLIENT_ID y REDIRECT): https://login.microsoftonline.com/common/adminconsent?client_id=CLIENT_ID&redirect_uri=REDIRECT_URI
BC_CONNECTOR_CLIENT_ID=
BC_CONNECTOR_CLIENT_SECRET=
# Business Central — sin conector: mock (solo dev). configJson del workspace: baseUrl o tenantId+environment+companyId; override oauth* opcional.
BC_ERP_USE_MOCK=true
BC_ERP_TIMEOUT_MS=60000
GRAPH_TENANT_ID=common
GRAPH_CLIENT_ID=your-graph-app-client-id
GRAPH_CLIENT_SECRET=your-graph-app-client-secret
# Renovación automática de webhooks Graph (correo). El worker corre en el mismo proceso que la API.
GRAPH_RENEW_WORKER_ENABLED=true
# Cada cuánto revisar suscripciones (ms). Default 1 h.
GRAPH_RENEW_INTERVAL_MS=3600000
# Renovar si el vencimiento cae dentro de esta ventana (ms). Default 48 h (margen ante caídas).
GRAPH_RENEW_BEFORE_MS=172800000

# Extraccion con OpenAI (opcional; sin clave se usa extraccion basica)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modelo para analizar el PDF tal cual (API Responses + input_file). Vacío = mismo que OPENAI_MODEL.
# gpt-4o-mini = barato; gpt-4o = mejor en facturas escaneadas o diseño complejo.
OPENAI_PDF_MODEL=
# true = envía el PDF binario a OpenAI (recomendado). false = solo texto extraído localmente (pdf-parse).
OPENAI_NATIVE_PDF=true

# Azure Document Intelligence (OCR + layout). Si AZURE_DI_KEY está vacío, se usa pdf-parse como fallback.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_API_VERSION=2024-11-30
AZURE_DI_MODEL_ID=prebuilt-layout

# true = logs en consola al recibir webhooks de Graph (diagnostico)
GRAPH_WEBHOOK_LOG=false
